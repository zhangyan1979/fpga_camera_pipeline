# =============================================================================
#  Generated build trees - never commit these.  Everything here is recreated by
#      vivado -mode batch -source ps/build_hw.tcl
#      xsct ps/build_app.tcl
# =============================================================================

# Vivado projects, runs, caches
build_hw/
*.runs/
*.cache/
*.gen/
*.hw/
*.sim/
ip_user_files/
.Xil/
webtalk/
*.dcp
*.ltx
*.bit
*.xpr

# Vitis workspaces and application build directories
vitis_ws*/
.metadata/
Debug/
Release/
*.elf
*.pdom

# exported hardware platform (regenerated from the XSA)
*.xsa

# simulation artefacts
xsim.dir/
xsim_proj/
*.pb
*.wdb
*.str
*.jou

# logs (reproducible transcripts)
*.log

# raw frame dumps (regenerated by ps/dump_fb.tcl + tools/fb2png.py)
*.bin

# implementation reports (regenerated by ps/build_hw.tcl)
ps/*.rpt

# OS / editor noise
Thumbs.db
desktop.ini
*~
